rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function empresaDoc(empresaId) {
      return get(/databases/$(database)/documents/techcell_empresas/$(empresaId));
    }
    function memberDoc(empresaId) {
      return get(/databases/$(database)/documents/techcell_empresas/$(empresaId)/usuarios/$(request.auth.uid));
    }
    function adminPath() {
      return /databases/$(database)/documents/techcell_platform_admins/$(request.auth.uid);
    }
    function isPlatformAdmin() {
      return request.auth != null
        && exists(adminPath())
        && get(adminPath()).data.ativo == true;
    }
    function isBootstrapDeveloper(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && userId == 'JMBDrlStQdNLD1km8hOrJmcJqXd2';
    }
    function isOwner(empresaId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/techcell_empresas/$(empresaId))
        && empresaDoc(empresaId).data.owner_uid == request.auth.uid;
    }
    function isActiveMember(empresaId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/techcell_empresas/$(empresaId)/usuarios/$(request.auth.uid))
        && memberDoc(empresaId).data.ativo == true;
    }
    function licensePath(empresaId) {
      return /databases/$(database)/documents/techcell_licenses/$(empresaId);
    }
    function licenseExists(empresaId) {
      return exists(licensePath(empresaId));
    }
    function licenseActive(empresaId) {
      return licenseExists(empresaId)
        && get(licensePath(empresaId)).data.status == 'ATIVA'
        && get(licensePath(empresaId)).data.master_ativo == true;
    }
    function tenantAllowed(empresaId) {
      return !licenseExists(empresaId) || licenseActive(empresaId) || isPlatformAdmin();
    }
    function legacyPermission(perfil, permissao) {
      return perfil == 'GERENTE'
        || (perfil == 'CAIXA' && (permissao == 'VENDER'
          || permissao == 'CLIENTES'
          || permissao == 'PRODUTOS'
          || permissao == 'PRODUTOS_EDITAR'
          || permissao == 'PRODUTOS_CUSTO'
          || permissao == 'RESUMO_DIA'));
    }
    function hasPermission(empresaId, permissao) {
      return isActiveMember(empresaId)
        && ((('permissoes' in memberDoc(empresaId).data)
              && memberDoc(empresaId).data.permissoes is list
              && memberDoc(empresaId).data.permissoes.hasAny([permissao]))
            || (!('permissoes' in memberDoc(empresaId).data)
              && legacyPermission(memberDoc(empresaId).data.perfil, permissao)));
    }
    function validStatus(status) {
      return status == 'PENDENTE' || status == 'AUTORIZADO'
        || status == 'NEGADO' || status == 'BLOQUEADO';
    }
    function slotValidAfter(empresaId, deviceId) {
      return request.resource.data.license_slot_id is string
        && request.resource.data.license_slot_id != ''
        && getAfter(/databases/$(database)/documents/techcell_licenses/$(empresaId)/caixa_slots/$(request.resource.data.license_slot_id)).data.status == 'EM_USO'
        && getAfter(/databases/$(database)/documents/techcell_licenses/$(empresaId)/caixa_slots/$(request.resource.data.license_slot_id)).data.device_uuid == deviceId
        && getAfter(/databases/$(database)/documents/techcell_licenses/$(empresaId)/caixa_slots/$(request.resource.data.license_slot_id)).data.uid == resource.data.uid;
    }
    function slotValidCurrent(empresaId, deviceId) {
      return request.resource.data.license_slot_id is string
        && request.resource.data.license_slot_id != ''
        && get(/databases/$(database)/documents/techcell_licenses/$(empresaId)/caixa_slots/$(request.resource.data.license_slot_id)).data.status == 'EM_USO'
        && get(/databases/$(database)/documents/techcell_licenses/$(empresaId)/caixa_slots/$(request.resource.data.license_slot_id)).data.device_uuid == deviceId
        && get(/databases/$(database)/documents/techcell_licenses/$(empresaId)/caixa_slots/$(request.resource.data.license_slot_id)).data.uid == resource.data.uid;
    }

    // Compatibilidade do Caixa da Loja que já está embutido no Tech Cell.
    // Mantém o histórico nas coleções antigas sem migrar ou apagar documentos.
    function legacyCaixaAllowed() {
      return request.auth != null
        && request.auth.token.email in [
          'techcellacs1@gmail.com',
          'techellacs1@gmail.com',
          'acsolar1611@gmail.com'
        ];
    }
    function legacyCaixaAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'techcellacs1@gmail.com',
          'techellacs1@gmail.com'
        ];
    }

    // Compatibilidade adicional com o Caixa 2.7.1 inicial.
    function legacyV271SignedIn() {
      return request.auth != null;
    }
    function legacyV271UserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function legacyV271SameStore(storeId) {
      return legacyV271SignedIn()
        && legacyV271UserDoc().data.storeId == storeId;
    }
    function legacyV271Admin() {
      return legacyV271SignedIn()
        && legacyV271UserDoc().data.role == 'admin';
    }
    function legacyV271Cashier() {
      return legacyV271SignedIn()
        && legacyV271UserDoc().data.role == 'cashier';
    }

    // A conta Desenvolvedor é global e independente do MASTER de qualquer empresa.
    // Bootstrap: somente a conta autenticada com o UID fixo abaixo pode criar o próprio documento uma única vez.
    // O e-mail fica apenas como dado de auditoria; o UID é a identidade de segurança.
    match /techcell_platform_admins/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());
      allow create: if isPlatformAdmin()
                    || (isBootstrapDeveloper(userId)
                        && request.resource.data.ativo == true
                        && request.resource.data.papel == 'DEVELOPER'
                        && request.resource.data.bootstrap_uid == userId);
      allow update, delete: if isPlatformAdmin();
    }

    // Caixa da Loja embutido no sistema atual: histórico preservado em top-level.
    match /movimentos/{movementId} {
      allow read: if isPlatformAdmin() || legacyCaixaAllowed();
      allow create: if isPlatformAdmin() || legacyCaixaAllowed();
      allow update, delete: if isPlatformAdmin() || legacyCaixaAdmin();
    }

    match /fechamentos/{closingId} {
      allow read: if isPlatformAdmin() || legacyCaixaAdmin();
      allow create, update, delete: if isPlatformAdmin() || legacyCaixaAdmin();
    }

    // Caixa 2.7.1: perfil e loja usados pelo aplicativo inicial.
    match /users/{uid} {
      allow read: if isPlatformAdmin()
                  || (legacyV271SignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /stores/{storeId}/movements/{movementId} {
      allow read: if isPlatformAdmin() || legacyV271SameStore(storeId);
      allow create, update: if isPlatformAdmin()
                            || (legacyV271SameStore(storeId)
                                && (legacyV271Admin() || legacyV271Cashier()));
      allow delete: if isPlatformAdmin()
                    || (legacyV271SameStore(storeId) && legacyV271Admin());
    }

    match /stores/{storeId}/expenses/{expenseId} {
      allow read: if isPlatformAdmin() || legacyV271SameStore(storeId);
      allow create, update, delete: if isPlatformAdmin()
                                    || (legacyV271SameStore(storeId) && legacyV271Admin());
    }

    match /stores/{storeId}/closings/{closingId} {
      allow read: if isPlatformAdmin() || legacyV271SameStore(storeId);
      allow create, update, delete: if isPlatformAdmin()
                                    || (legacyV271SameStore(storeId) && legacyV271Admin());
    }

    // Licença comercial controlada exclusivamente pelo Desenvolvedor.
    match /techcell_licenses/{empresaId} {
      allow read: if isPlatformAdmin() || isOwner(empresaId) || isActiveMember(empresaId);
      allow create, update, delete: if isPlatformAdmin();

      match /caixa_slots/{slotId} {
        allow read: if isPlatformAdmin() || isOwner(empresaId);
        allow create, delete: if isPlatformAdmin();
        allow update: if isPlatformAdmin()
          || (isOwner(empresaId)
              && licenseActive(empresaId)
              && resource.data.empresa_uuid == empresaId
              && request.resource.data.empresa_uuid == empresaId
              && resource.data.tipo == 'CAIXA'
              && request.resource.data.tipo == 'CAIXA'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','device_uuid','uid','updated_at'])
              && (
                (resource.data.status == 'LIVRE'
                  && request.resource.data.status == 'EM_USO'
                  && request.resource.data.device_uuid != ''
                  && request.resource.data.uid != '')
                ||
                (resource.data.status == 'EM_USO'
                  && request.resource.data.status == 'LIVRE'
                  && request.resource.data.device_uuid == ''
                  && request.resource.data.uid == '')
              ));
      }
    }

    // Índice privado conta -> empresa. Cada usuário lê somente o próprio vínculo.
    match /techcell_user_empresas/{userId}/empresas/{empresaId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());
      allow create, update: if isPlatformAdmin()
                            || (isOwner(empresaId)
                                && request.resource.data.uid == userId
                                && request.resource.data.empresa_uuid == empresaId);
      allow delete: if isPlatformAdmin() || isOwner(empresaId);
    }

    // Solicitação/autorização de aparelhos. Uma empresa licenciada só autoriza Caixa
    // quando existe uma vaga física de licença ligada ao device_uuid.
    match /techcell_device_requests/{empresaId}/devices/{deviceId} {
      allow create: if request.auth != null
                    && (isOwner(empresaId) || isActiveMember(empresaId))
                    && tenantAllowed(empresaId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.empresa_uuid == empresaId
                    && request.resource.data.device_uuid == deviceId
                    && request.resource.data.status == 'PENDENTE';

      allow read: if isPlatformAdmin() || isOwner(empresaId)
                  || (request.auth != null && resource.data.uid == request.auth.uid);

      allow update: if isPlatformAdmin()
        || (isOwner(empresaId)
            && validStatus(request.resource.data.status)
            && (
              request.resource.data.status != 'AUTORIZADO'
              || !licenseExists(empresaId)
              || (licenseActive(empresaId) && slotValidAfter(empresaId, deviceId))
            ))
        || (request.auth != null
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.empresa_uuid == resource.data.empresa_uuid
            && request.resource.data.device_uuid == resource.data.device_uuid
            && (
              (resource.data.status == 'PENDENTE'
                && request.resource.data.status == 'PENDENTE'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_request_at','updated_at']))
              ||
              (resource.data.status == 'PENDENTE'
                && request.resource.data.status == 'AUTORIZADO'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','provided_code','code_used_at','updated_at'])
                && exists(/databases/$(database)/documents/techcell_device_codes/$(empresaId)/devices/$(deviceId))
                && get(/databases/$(database)/documents/techcell_device_codes/$(empresaId)/devices/$(deviceId)).data.code == request.resource.data.provided_code
                && get(/databases/$(database)/documents/techcell_device_codes/$(empresaId)/devices/$(deviceId)).data.expires_at > request.time
                && (!licenseExists(empresaId) || (licenseActive(empresaId) && slotValidCurrent(empresaId, deviceId))))
            ));

      allow delete: if isPlatformAdmin() || isOwner(empresaId);
    }

    // Código alternativo é segredo do Master/Desenvolvedor.
    match /techcell_device_codes/{empresaId}/devices/{deviceId} {
      allow read, create, update, delete: if isPlatformAdmin() || isOwner(empresaId);
    }

    match /techcell_empresas/{empresaId} {
      allow create: if request.auth != null
                    && request.resource.data.owner_uid == request.auth.uid;
      allow read: if isPlatformAdmin() || isOwner(empresaId) || isActiveMember(empresaId);
      allow update, delete: if isPlatformAdmin()
                            || (isOwner(empresaId)
                                && tenantAllowed(empresaId)
                                && request.resource.data.owner_uid == request.auth.uid);

      match /usuarios/{userId} {
        allow read: if isPlatformAdmin() || isOwner(empresaId)
                    || (request.auth != null && request.auth.uid == userId);
        allow create, update, delete: if isPlatformAdmin()
                                     || (isOwner(empresaId) && tenantAllowed(empresaId));
      }

      match /produtos/{produtoId} {
        allow read: if isPlatformAdmin() || isOwner(empresaId) || isActiveMember(empresaId);
        allow create, update: if isPlatformAdmin()
          || (tenantAllowed(empresaId) && isOwner(empresaId))
          || (tenantAllowed(empresaId)
              && hasPermission(empresaId, 'PRODUTOS_EDITAR')
              && request.resource.data.empresa_uuid == empresaId
              && request.resource.data.cloud_source_uid == request.auth.uid);
        allow delete: if isPlatformAdmin() || (isOwner(empresaId) && tenantAllowed(empresaId));
      }

      match /vendas_entrada/{saleId} {
        allow read: if isPlatformAdmin() || isOwner(empresaId) || isActiveMember(empresaId);
        allow create: if isPlatformAdmin()
                      || (tenantAllowed(empresaId) && isOwner(empresaId))
                      || (tenantAllowed(empresaId)
                          && isActiveMember(empresaId)
                          && request.resource.data.empresa_uuid == empresaId
                          && request.resource.data.source_uid == request.auth.uid
                          && request.resource.data.status == 'PENDENTE_MASTER');
        allow update: if isPlatformAdmin()
                      || (tenantAllowed(empresaId) && isOwner(empresaId))
                      || (tenantAllowed(empresaId)
                          && isActiveMember(empresaId)
                          && resource.data.source_uid == request.auth.uid
                          && request.resource.data.source_uid == request.auth.uid
                          && request.resource.data.empresa_uuid == empresaId
                          && resource.data.status != 'ACEITA_MASTER'
                          && request.resource.data.status == 'PENDENTE_MASTER');
        allow delete: if isPlatformAdmin() || (isOwner(empresaId) && tenantAllowed(empresaId));
      }

      match /{document=**} {
        allow read: if isPlatformAdmin() || isOwner(empresaId) || isActiveMember(empresaId);
        allow write: if isPlatformAdmin() || (isOwner(empresaId) && tenantAllowed(empresaId));
      }
    }
  }
}
