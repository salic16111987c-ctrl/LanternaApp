rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function empresaDoc(empresaId) {
      return get(/databases/$(database)/documents/techcell_empresas/$(empresaId));
    }
    function memberDoc(empresaId) {
      return get(/databases/$(database)/documents/techcell_empresas/$(empresaId)/usuarios/$(request.auth.uid));
    }
    function isOwner(empresaId) {
      return request.auth != null
        && empresaDoc(empresaId).data.owner_uid == request.auth.uid;
    }
    function isActiveMember(empresaId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/techcell_empresas/$(empresaId)/usuarios/$(request.auth.uid))
        && memberDoc(empresaId).data.ativo == true;
    }
    function legacyPermission(perfil, permissao) {
      return perfil == 'GERENTE'
        || (perfil == 'CAIXA' && (permissao == 'VENDER'
          || permissao == 'CLIENTES'
          || permissao == 'PRODUTOS'
          || permissao == 'PRODUTOS_EDITAR'
          || permissao == 'PRODUTOS_CUSTO'
          || permissao == 'RESUMO_DIA'));
    }
    function hasPermission(empresaId, permissao) {
      return isActiveMember(empresaId)
        && ((('permissoes' in memberDoc(empresaId).data)
              && memberDoc(empresaId).data.permissoes is list
              && memberDoc(empresaId).data.permissoes.hasAny([permissao]))
            || (!('permissoes' in memberDoc(empresaId).data)
              && legacyPermission(memberDoc(empresaId).data.perfil, permissao)));
    }

    // Índice privado conta -> empresa. Cada usuário lê somente o próprio vínculo.
    match /techcell_user_empresas/{userId}/empresas/{empresaId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isOwner(empresaId)
                            && request.resource.data.uid == userId
                            && request.resource.data.empresa_uuid == empresaId;
      allow delete: if isOwner(empresaId);
    }

    // Solicitação/autorização do aparelho fica fora da árvore genérica da empresa,
    // para um funcionário nunca poder listar pedidos de outros usuários.
    match /techcell_device_requests/{empresaId}/devices/{deviceId} {
      allow create: if request.auth != null
                    && (isOwner(empresaId) || isActiveMember(empresaId))
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.empresa_uuid == empresaId
                    && request.resource.data.device_uuid == deviceId
                    && request.resource.data.status == 'PENDENTE';

      allow read: if isOwner(empresaId)
                  || (request.auth != null && resource.data.uid == request.auth.uid);

      allow update: if isOwner(empresaId)
        || (request.auth != null
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.empresa_uuid == resource.data.empresa_uuid
            && request.resource.data.device_uuid == resource.data.device_uuid
            && (
              (resource.data.status == 'PENDENTE'
                && request.resource.data.status == 'PENDENTE'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_request_at','updated_at']))
              ||
              (resource.data.status == 'PENDENTE'
                && request.resource.data.status == 'AUTORIZADO'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','provided_code','code_used_at','updated_at'])
                && exists(/databases/$(database)/documents/techcell_device_codes/$(empresaId)/devices/$(deviceId))
                && get(/databases/$(database)/documents/techcell_device_codes/$(empresaId)/devices/$(deviceId)).data.code == request.resource.data.provided_code
                && get(/databases/$(database)/documents/techcell_device_codes/$(empresaId)/devices/$(deviceId)).data.expires_at > request.time)
            ));

      allow delete: if isOwner(empresaId);
    }

    // Segredo do código alternativo: somente o Master proprietário pode ler/gravar.
    match /techcell_device_codes/{empresaId}/devices/{deviceId} {
      allow read, create, update, delete: if isOwner(empresaId);
    }

    match /techcell_empresas/{empresaId} {
      allow create: if request.auth != null
                    && request.resource.data.owner_uid == request.auth.uid;
      allow read: if isOwner(empresaId) || isActiveMember(empresaId);
      allow update, delete: if isOwner(empresaId)
                            && request.resource.data.owner_uid == request.auth.uid;

      match /usuarios/{userId} {
        allow read: if isOwner(empresaId)
                    || (request.auth != null && request.auth.uid == userId);
        allow create, update, delete: if isOwner(empresaId);
      }

      match /produtos/{produtoId} {
        allow read: if isOwner(empresaId) || isActiveMember(empresaId);
        allow create, update: if isOwner(empresaId)
          || (hasPermission(empresaId, 'PRODUTOS_EDITAR')
              && request.resource.data.empresa_uuid == empresaId
              && request.resource.data.cloud_source_uid == request.auth.uid);
        allow delete: if isOwner(empresaId);
      }

      match /vendas_entrada/{saleId} {
        allow read: if isOwner(empresaId) || isActiveMember(empresaId);
        allow create: if isOwner(empresaId)
                      || (isActiveMember(empresaId)
                          && request.resource.data.empresa_uuid == empresaId
                          && request.resource.data.source_uid == request.auth.uid
                          && request.resource.data.status == 'PENDENTE_MASTER');
        allow update: if isOwner(empresaId)
                      || (isActiveMember(empresaId)
                          && resource.data.source_uid == request.auth.uid
                          && request.resource.data.source_uid == request.auth.uid
                          && request.resource.data.empresa_uuid == empresaId
                          && resource.data.status != 'ACEITA_MASTER'
                          && request.resource.data.status == 'PENDENTE_MASTER');
        allow delete: if isOwner(empresaId);
      }

      match /{document=**} {
        allow read: if isOwner(empresaId) || isActiveMember(empresaId);
        allow write: if isOwner(empresaId);
      }
    }
  }
}
