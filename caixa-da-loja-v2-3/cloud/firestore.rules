rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function empresaDoc(empresaId) {
      return get(/databases/$(database)/documents/techcell_empresas/$(empresaId));
    }
    function isOwner(empresaId) {
      return request.auth != null
        && empresaDoc(empresaId).data.owner_uid == request.auth.uid;
    }
    function isActiveMember(empresaId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/techcell_empresas/$(empresaId)/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/techcell_empresas/$(empresaId)/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    match /techcell_empresas/{empresaId} {
      allow create: if request.auth != null
                    && request.resource.data.owner_uid == request.auth.uid;
      allow read: if isOwner(empresaId) || isActiveMember(empresaId);
      allow update, delete: if isOwner(empresaId)
                            && request.resource.data.owner_uid == request.auth.uid;

      match /usuarios/{userId} {
        allow read: if isOwner(empresaId)
                    || (request.auth != null && request.auth.uid == userId);
        allow create, update, delete: if isOwner(empresaId);
      }

      match /{document=**} {
        allow read: if isOwner(empresaId) || isActiveMember(empresaId);
        // Nesta fase o Master continua sendo a autoridade que grava na nuvem.
        allow write: if isOwner(empresaId);
      }
    }
  }
}
